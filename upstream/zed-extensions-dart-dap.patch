+      "description": "Path to the working directory"
+    },
+    "useFvm": {
+      "type": "boolean",
+      "description": "Weather to use fvm to run the Dart/Flutter program"
+    },
+    "args": {
+      "type": "array",
+      "description": "Arguments passed to the Dart program.",
+      "items": {
+        "type": "string"
+      },
+      "default": []
+    },
+    "device_id": {
