// .zed/keymap.json — Flutter workflows (hot reload, DevTools, log debugging)
//
// Copy to your project's .zed/keymap.json after running zed-flutter-init.sh
//
// Zed limitation: terminals and the debug console support search (Ctrl+Shift+F in
// terminal) but not "filter lines" (hide non-matches). Use the log export tasks or
// DevTools → Logging for structured debug output.

[
  {
    "context": "Workspace",
    "bindings": {
      // DevTools & inspector (requires running app + cached VM URI or run.log)
      "shift-d": ["task::Spawn", { "task_name": "Flutter: DevTools (connected)" }],
      "shift-i": ["task::Spawn", { "task_name": "Flutter: DevTools (widget inspector)" }],
      "shift-l": ["task::Spawn", { "task_name": "Flutter: DevTools (logging)" }],

      // Log debugging workarounds
      "shift-e": ["task::Spawn", { "task_name": "Flutter: export errors to filtered.log" }],
      "shift-w": ["task::Spawn", { "task_name": "Flutter: watch run log (live filter)" }],

      // Run with persistent log file (pair with watch/export tasks)
      "shift-r": ["task::Spawn", { "task_name": "Flutter: run (tee to log)" }]
    }
  },

  // Terminal search: Ctrl+Shift+F (Linux/Windows) — highlights matches in scrollback
  // Editor search on exported log: open .zed/flutter/filtered.log then Ctrl+F

  {
    "context": "Terminal",
    "bindings": {
      // Forward common readline search if needed (optional)
      "ctrl-shift-f": "pane::DeploySearch"
    }
  }
]
